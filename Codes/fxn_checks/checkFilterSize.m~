clear all 
clc
close all

%%
SX_RC1_setting
subjList = {'YK', 'SP', 'SX', 'LS', 'RE', 'MD', 'AS', 'HL', 'FH', 'HA', 'CS', 'DT'}; % Initials of 12 subjects
nblocks_allSubj = [200, 240, 210, 240, 220, 220, 215, 220, 205, 210, 205, 205]; % number of blocks each subj completed

psz_stim = 96;
iLoc = 1;

nsubj=12;
nORI = 29;
nSF = 29;
sz_all = [.6, 1, 1.4];
nSZ = length(sz_all);
itype=2;
ifamily_perF = [1,2];
paramInd_perF = {[1,1,1], [1,1,1, 1]};
flag_standEnergy = 1;
colors = {'r', 'g', 'b'};

marg_ORI_all = nan(nsubj, nSZ, nORI);
marg_SF_all = nan(nsubj, nSZ, nSF);
margPred_ORI_all = nan(nsubj, nSZ, nORI);
margPred_SF_all = nan(nsubj, nSZ, nSF);
params_ORI_all = nan(nsubj, nSZ, 3);
params_SF_all = nan(nsubj, nSZ, 4);

%%
for isubj = 1:nsubj
    
    subjName = subjList{isubj};
    nblocks = nblocks_allSubj(isubj);
    fprintf('%s%d (%d/%d) starting...\n', subjName, nblocks, isubj, nsubj)
    
    %% load and clear
    % dataMtx
    nameBehavMeas = sprintf('Data_OOD/%s%d/%s_behavMeas.mat', subjName, nblocks, subjName);
    load(nameBehavMeas)
    
    % noise patch
    nameNoisePatch = sprintf('Data/%s/%s%d_noise.mat', subjName, subjName, nblocks);
    load(nameNoisePatch)
    
    locInx = dataMatrix(:, 5);
    noise_all_raw = noise_allT(locInx == iLoc); clear noise_allT
    iPRS_all = dataMatrix(locInx == iLoc, 6);
    cst = dataMatrix(locInx == iLoc, end);
    ntrials = length(noise_all_raw);
    
    %% create filter with diff size
    for iSZ = 1:nSZ
        fprintf('   - sz #%d/%d starting...', iSZ, nSZ)
        
        psz_filter = round(psz_stim*sz_all(iSZ));
        stim.aper_psz = psz_filter; % 60, 140
        [filter_sin_sized, filter_cos_sized] = SX_sim02_setFilters(stim, noise.filtersSF_all, filtersOri_all, 0);
        sz_min = min([size(noise_all_raw{1}, 1), size(filter_sin_sized{1,1}, 1)]);
        noise_all = {};
        if size(noise_all_raw{1}, 1) > size(filter_sin_sized{1,1}, 1) % filter smaller than the stim
            for itrial = 1:ntrials
                noiseP = noise_all_raw{itrial};
                ipx_start = round((psz_stim - psz_filter)/2+1);
                ipx_end = round(ipx_start+psz_filter-1);
                noise_all{itrial} = noiseP(ipx_start:ipx_end, ipx_start:ipx_end);
            end
            stim.aper_psz = sz_min;
            filter_sin_matched = filter_sin_sized;
            filter_cos_matched = filter_cos_sized;
        else
            ipx_start = round((psz_filter-psz_stim)/2+1);
            ipx_end = round(ipx_start+psz_stim-1);
            for iORI=1:nORI
                parfor iSF = 1:nSF
                    filter_sin_matched{iORI, iSF} = filter_sin_sized{iORI, iSF}(ipx_start:ipx_end, ipx_start:ipx_end);
                    filter_cos_matched{iORI, iSF} = filter_cos_sized{iORI, iSF}(ipx_start:ipx_end, ipx_start:ipx_end);
                end
            end
            stim.aper_psz = 96; % 60, 140
            noise_all = noise_all_raw;
        end
        
        fprintf('Filters created.')
        
        %%  calculate energy [time-consuminng]
        nameEnergySZ = sprintf('varyFilterSZ/%s%d_energy_x%d.mat', subjName, nblocks, round(sz_all(iSZ)*10));
        dirE = dir(nameEnergySZ);
        if isempty(dirE)
            stim.mask  = exp_CreateCircularApertureSin(stim);
            % [e3D_small, ~] = SX_RC4_Energy_parfor(stim.mask, noise_all, filter_sin_matched, filter_cos_matched);
            [e3D, ~] = SX_RC4_Energy_parfor(stim.mask, noise_all, filter_sin_matched, filter_cos_matched);

        else
            load(nameEnergySZ)
            fprintf('Energy loaded.')
        end
        
        %% get sensitivity kernel
        nameKernelSZ = sprintf('varyFilterSZ/%s%d_kernel_x%d.mat', subjName, nblocks, round(sz_all(iSZ)*10));
        dirK = dir(nameKernelSZ);
        if isempty(dirK)
            e3D_norm = normEnergy(e3D, iPRS_all, cst);
            kernels2D = SX_RC6_kernel_parfor(e3D_norm, dataMatrix(locInx == iLoc, :), filtersSF_all, filtersOri_all);
            save(nameKernelSZ, 'kernels2D')
            clear e3D*
            fprintf('kernel generated.\n')
        else
            load(nameKernelSZ)
            fprintf('kernel loaded.\n')
        end
        marg_ORI = squeeze(mean(kernels2D(itype, :, :), 3));
        marg_SF = squeeze(mean(kernels2D(itype, :, :), 2));
        iF = 1; [margPred_ORI, params_ORI] = quick_fit(iF, marg_ORI, ub_full_all{ifamily_perF(iF)}, lb_full_all{ifamily_perF(iF)}, ifamily_perF, paramInd_perF);
        iF = 2; [margPred_SF, params_SF] = quick_fit(iF, marg_SF, ub_full_all{ifamily_perF(iF)}, lb_full_all{ifamily_perF(iF)}, ifamily_perF, paramInd_perF);
        
        %%
        figure('Position', [0 0  1e3 400])
        subplot(1,2,1), hold on
        plot(axis_tuning{1}, marg_ORI, 'ko')
        plot(axis_tuning{1}, margPred_ORI, 'k-', 'handlevisibility', 'off')
        xline(0, 'k-');
        xticks(-90:45:90)
        xlim([-100, 100])
        xlabel('Orientation (deg)')
        
        subplot(1,2,2), hold on
        plot(axis_tuning{2}, marg_SF, 'ko')
        plot(axis_tuning{2}, margPred_SF, 'k-', 'handlevisibility', 'off')
        xline(1, 'k-');
        xticks(0:.5:2)
        xlabel('SF (cpd)')
        xticklabels(round(2.^(0:.5:2), 2))
        xlim([-.11, 2.11])
        
        set(findall(gcf, '-property', 'LineWidth'), 'LineWidth',2)
        set(findall(gcf, '-property', 'fontsize'), 'fontsize',20)
    
        %% compile
        marg_ORI_all(isubj, iSZ, :) = marg_ORI;
        marg_SF_all(isubj, iSZ, :) = marg_SF;
        margPred_ORI_all(isubj, iSZ, :) = margPred_ORI;
        margPred_SF_all(isubj, iSZ, :) = margPred_SF;
        params_ORI_all(isubj, iSZ, :) = params_ORI;
        params_SF_all(isubj, iSZ, :) = params_SF;

    end % iSZ
    
    %% plot all sizes
    figure('Position', [0 0  1e3 400])
    subplot(1,2,1), hold on
    for iSZ = 1:nSZ
        color = colors{iSZ};
        plot(axis_tuning{1}, squeeze(marg_ORI_all(isubj, iSZ, :)), [color, 'o'])
        plot(axis_tuning{1}, squeeze(margPred_ORI_all(isubj, iSZ, :)),[color, '-'], 'handlevisibility', 'off')
        legends{iSZ} = sprintf('RF size=x%.1f stim size', sz_all(iSZ));
    end
    xline(0, 'k-');
    xticks(-90:45:90)
    xlim([-100, 100])
    xlabel('Orientation (deg)')
    legend(legends, 'location', 'south')
    
    subplot(1,2,2), hold on
    for iSZ = 1:nSZ
        color = colors{iSZ};
        plot(axis_tuning{2}, squeeze(marg_SF_all(isubj, iSZ, :)), [color, 'o'])
        plot(axis_tuning{2}, squeeze(margPred_SF_all(isubj, iSZ, :)),[color, '-'], 'handlevisibility', 'off')
        legends{iSZ} = sprintf('RF size=x%.1f stim size', sz_all(iSZ));
    end
    
    xline(1, 'k-');
    xticks(0:.5:2)
    xlabel('SF (cpd)')
    xticklabels(round(2.^(0:.5:2), 2))
    xlim([-.11, 2.11])
    set(findall(gcf, '-property', 'LineWidth'), 'LineWidth',2)
    set(findall(gcf, '-property', 'fontsize'), 'fontsize',20)

end % isubj

%% plot params
figure('Position', [0 0  1e3 400])
for iparam = 1:3
    subplot(1,3,iparam), hold on
    ave = squeeze(mean(params_ORI_all(:, :, iparam), 1));
    se = squeeze(mean(params_ORI_all(:, :, iparam), 1))/sqrt(nsubj);
    errorbar(1:nSZ, ave, se)
end

figure('Position', [0 0  1e3 400])
for iparam = 1:4
    subplot(1,4,iparam), hold on
    ave = squeeze(mean(params_SF_all(:, :, iparam), 1));
    se = squeeze(mean(params_SF_all(:, :, iparam), 1))/sqrt(nsubj);
    errorbar(1:nSZ, ave, se)
end
        
