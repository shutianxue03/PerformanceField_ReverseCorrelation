function [margPred, params_est] = quick_fit(ifeature, marg, ub, lb, ifamily_perF, paramInd_perF)
SX_RC1_setting
options = optimoptions('fmincon','MaxIterations',5000,'Display','off');
nrep = 20; % number of reps to find the global minimum
sampParam0 = @(lb, ub, n) rand(1,n) .* (ub-lb) + lb;
params0 = sampParam0(lb, ub, length(lb));
ifamily = ifamily_perF(ifeature);
% get x
if ifeature==1
    axis_ln = axis_tuning{ifeature};
else
    axis_ln = 2.^axis_tuning{ifeature};
end

fxn_minimizeDev_ML = @(kernelParams) MC_getDev(kernelParams, axis_ln, marg, ifamily);
problem_ML = createOptimProblem('fmincon','objective', fxn_minimizeDev_ML,'x0',params0,'lb',lb,'ub',ub,'options',options);
ms_ML = MultiStart('StartPointsToRun', 'bounds','UseParallel', 1, 'Display', 'off');
params_est = run(ms_ML, problem_ML, nrep);

% predict
margPred = predSFkernel(axis_ln, ifamily, params_est, 0);

end

function deviance = MC_getDev(params_fit_, xData, yData, ifamily)

nfilters = length(yData);
yData = reshape(yData,[1, nfilters]);
y_pred = predSFkernel(xData, ifamily, params_fit_, 0);
y_pred = reshape(y_pred,1, nfilters);
deviance_= sum((yData - y_pred).^2);
deviance = sum(deviance_(:))/nfilters;

end

